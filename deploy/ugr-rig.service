# /etc/systemd/system/ugr-rig.service
#
# The rig server: owns the head and the camera, serves the pages on the Pi's own WiFi.
# Paths assume user `ugr`, the repository in ~/ugr_rig with a venv in .venv, and data in
# ~/ugr_data. Adjust all three together.
[Unit]
Description=UGR rig server (mount, camera, web UI)
Requires=pigpiod.service
After=pigpiod.service network-online.target
Wants=network-online.target

[Service]
User=ugr
Group=ugr
WorkingDirectory=/home/ugr/ugr_rig
ExecStart=/home/ugr/ugr_rig/.venv/bin/python -m web --backend pigpio --camera gphoto2 --host 0.0.0.0 --port 8000 --data /home/ugr/ugr_data --shutdown-command "sudo -n /usr/bin/systemctl poweroff"
# The page's Shutdown button runs that; it needs deploy/ugr-shutdown.sudoers (README §6).
# On stop the server cuts any motion and releases the drivers (rig.close()).
TimeoutStopSec=15
Restart=on-failure
RestartSec=5
# Memory cap (2026-11-26, deploy/README.md §8). The server runs at ~150 MB (sim, desk); its
# analysis worker on real CR2s is not measured yet. 3 GB should only be reached by something
# running away (check `health:` lines in the journal after the first real study). Then the kernel
# kills it inside this service and systemd starts it again after RestartSec: SSH and the rest
# of the Pi stay usable instead of the whole Pi grinding to a halt. A restart loses the head's
# position (open loop): re-zero before the next study. MemorySwapMax=0 keeps the service out
# of swap on the SD card, which is what makes a Pi short of memory crawl.
MemoryMax=3G
MemorySwapMax=0

[Install]
WantedBy=multi-user.target
